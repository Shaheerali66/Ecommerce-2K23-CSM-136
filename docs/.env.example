# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=4000

# Either set DATABASE_URL, or the individual DB_* fields below.
# DATABASE_URL=postgres://user:password@localhost:5432/kaarigar_dev
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kaarigar_dev
TEST_DB_NAME=kaarigar_test

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
